pkgname=karry-git
pkgver=0.1.2
pkgrel=1
pkgdesc="Back up, restore and sync your KDE Plasma setup"
arch=(x86_64 aarch64)
url="https://github.com/SeniorMatt/karry"
license=(GPL-3.0-or-later)
depends=(qt6-base ki18n kcoreaddons kwidgetsaddons)
makedepends=(git cargo cmake ninja)
optdepends=('git: sync through a git remote')
provides=(karry)
conflicts=(karry)
source=("git+$url.git")
sha256sums=(SKIP)

pkgver() {
  cd karry
  printf "0.1.2.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd karry
  cargo build --release --locked -p karry-cli
  cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  cd karry
  cargo test --release --locked -p karry-core
}

package() {
  cd karry
  DESTDIR="$pkgdir" cmake --install build
  install -Dm755 target/release/karry-cli -t "$pkgdir/usr/bin/"
}
