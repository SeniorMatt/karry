pkgname=karry-git
pkgver=0.1.2
pkgrel=1
pkgdesc="Back up, restore and sync your KDE Plasma setup"
arch=(x86_64 aarch64)
url="https://github.com/SeniorMatt/karry"
license=(GPL-3.0-or-later)
depends=(qt6-base qt6-declarative qt6-svg kirigami qqc2-desktop-style kconfig)
makedepends=(git cargo cmake)
optdepends=('git: sync through a git remote')
options=(!lto)
provides=(karry)
conflicts=(karry)
source=("git+$url.git")
sha256sums=(SKIP)

pkgver() {
  cd karry
  printf "0.1.2.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd karry
  cargo build --release --locked
}

check() {
  cd karry
  cargo test --release --locked -p karry-core
}

package() {
  cd karry
  install -Dm755 target/release/karry target/release/karry-cli -t "$pkgdir/usr/bin/"
  install -Dm644 crates/karry-app/org.kde.karry.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 crates/karry-app/org.kde.karry.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
}
